# Copy to .env and fill in. .env is gitignored — never commit real values.

# Apify — console.apify.com/settings/integrations
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Elasticsearch Serverless — the endpoint, not the Kibana URL
ES_ENDPOINT=https://your-project.es.us-east-1.aws.elastic.cloud:443
ES_API_KEY=

# Anthropic — platform.claude.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Optional overrides
RECEIPTS_INDEX=receipts
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium
